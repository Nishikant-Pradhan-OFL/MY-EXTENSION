{
  "manifest_version": 3,
  "name": "Color Changer",
  "version": "1.0",
  "description": "Change page background color.",
  "permissions": ["scripting", "activeTab"],
  "action": {
    "default_icon": "icon.png",
    "default_title": "Click to change color"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}

"action": {
  "default_popup": "popup.html",
  "default_icon": "icon.png",
  "default_title": "Choose background color"
}
